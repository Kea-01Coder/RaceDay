@model RaceDay_PoE.Models.EventDtos.CreateEventRequest
@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Create New Event</h4>
            </div>
            <div class="card-body">
                <form asp-action="CreateEvent" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Event Title</label>
                        <input asp-for="Title" class="form-control" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventDateTime" class="form-label">Date & Time</label>
                            <input asp-for="EventDateTime" class="form-control" type="datetime-local" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label">Location</label>
                            <input asp-for="Location" class="form-control" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="MaxParticipants" class="form-label">Max Participants</label>
                            <input asp-for="MaxParticipants" class="form-control" type="number" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="EntryFee" class="form-label">Entry Fee (R)</label>
                            <input asp-for="EntryFee" class="form-control" type="number" step="0.01" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="EarlyBirdFee" class="form-label">Early Bird Fee (R)</label>
                            <input asp-for="EarlyBirdFee" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100">Create Event</button>
                </form>
            </div>
        </div>
    </div>
</div>
