@model List<RaceDay_PoE.Models.Dto.EnrollmentDto>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2 class="mb-4">My Enrolments</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You haven't enrolled in any events yet. <a asp-controller="Home" asp-action="Index">Browse Events</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.EventTitle</td>
                                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@item.CategoryName</td>
                                <td>
                                    <!-- Color coding for Status (Green = Confirmed, Amber = Pending, Red = Cancelled) -->
                                    <span class="badge @(item.Status.ToLower() == "confirmed" ? "bg-success" : item.Status.ToLower() == "pending" ? "bg-warning text-dark" : "bg-danger")">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">@item.PaymentStatus</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
