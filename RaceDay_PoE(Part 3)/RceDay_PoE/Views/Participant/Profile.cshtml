@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <h2>My Profile</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mt-3">
        <div class="card-body">
            <h4 class="card-title">Upload Profile Picture</h4>
            <!-- The enctype is CRUCIAL for file uploads -->
            <form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Select Image</label>
                    <input type="file" name="profilePicture" class="form-control" accept="image/*" required />
                </div>
                <button type="submit" class="btn btn-primary">Upload</button>
            </form>
        </div>
    </div>
</div>