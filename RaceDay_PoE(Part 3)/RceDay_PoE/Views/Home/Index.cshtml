@model List<RaceDay_PoE.Models.Dto.EventDto>
@{
    ViewData["Title"] = "Upcoming Events";
}
<div class="p-5 mb-5 rounded-3 text-white shadow-lg" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
    <div class="container-fluid py-3">
        <h1 class="display-4 fw-bold">🏃‍♂️ Ready for the Race?</h1>
        <p class="col-md-8 fs-4">Find your next challenge, push your limits, and join the RaceDay community.</p>
        @if (!User.Identity.IsAuthenticated)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-warning btn-lg mt-3 fw-bold text-dark">Join Now</a>
        }
    </div>
</div>

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold">Upcoming Races</h1>
    <p class="lead">Find your next challenge and join the pack.</p>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-primary">@ev.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@ev.Location</h6>
                        <p class="card-text">@ev.Description</p>
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">@ev.EventDateTime.ToString("dd MMM yyyy")</li>
                        <li class="list-group-item fw-bold text-success">R @ev.EntryFee</li>
                    </ul>
                    <div class="card-body">
                        <a asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-outline-primary w-100">View Details</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center">
            <h4>No events found. Check back later!</h4>
        </div>
    }
</div>
