{
  "profiles": {
    "http": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5063"
    },
    "https": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7124;http://localhost:5063"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080",
        "ApiSettings__BaseUrl": "http://host.docker.internal:5037/"
      },
      "publishAllPorts": true,
      "useSSL": true
    }
  },

  {
    "Logging": { "..." },
    "AllowedHosts": "*",
    "ApiSettings": {
      "BaseUrl": "http://localhost:5037/"
    }
  }
  "$schema": "https://json.schemastore.org/launchsettings.json"
}